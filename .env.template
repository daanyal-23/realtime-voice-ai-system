#  Voice AI — Environment Configuration

# Groq API Key (FREE — get yours at https://console.groq.com)
# Steps: Sign up → API Keys → Create API Key → paste below
GROQ_API_KEY=gsk_your_key_here

# ─── Optional Settings ────────────────────────

# WebSocket server host (default: 0.0.0.0)
# HOST=0.0.0.0

# WebSocket server port (default: 8765)
# PORT=8765

# ─── LLM Settings ──────────────────────────────
# Primary and fallback Groq models
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# LLM_MAX_COMPLETION_TOKENS=400
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_S=4
# LLM_STREAM_IDLE_TIMEOUT_S=5
