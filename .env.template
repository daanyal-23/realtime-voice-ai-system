#  Voice AI — Environment Configuration

# Groq API Key (FREE — get yours at https://console.groq.com)
# Steps: Sign up → API Keys → Create API Key → paste below
GROQ_API_KEY=gsk_your_key_here

# ─── Optional Settings ────────────────────────

# WebSocket server host (default: 0.0.0.0)
# HOST=0.0.0.0

# WebSocket server port (default: 8765)
# PORT=8765

# ─── LLM Settings ──────────────────────────────
# Primary and fallback Groq models
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# LLM_MAX_COMPLETION_TOKENS=400
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_S=4
# LLM_STREAM_IDLE_TIMEOUT_S=5

# ─── VAD Settings ──────────────────────────────
# VAD_SPEECH_CONFIRM_FRAMES=5
# VAD_SILENCE_CONFIRM_FRAMES=15
# VAD_SPEECH_THRESHOLD=0.02
# VAD_SILENCE_THRESHOLD=0.01
# VAD_EMA_ALPHA=0.05

# ─── TTS Settings ──────────────────────────────
# SAPI5 voice name preference (default: Hazel; falls back to any English voice)
# TTS_VOICE=Hazel
# TTS Provider (default: openai if OPENAI_API_KEY is set, else sapi5)
# TTS_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=cedar
# OPENAI_TTS_SPEED=1.15
# OPENAI_TTS_INSTRUCTIONS=Speak in a warm, professional British English receptionist voice. Use a natural, confident, moderately brisk conversational pace. Avoid unnecessarily long pauses. Keep pronunciation clear and reassuring.
